# Chat Model Relay configuration
# Copy this file to .env before starting Docker Compose.

# Optional bearer token. Keep this set if the gateway may be exposed beyond localhost.
RELAY_API_KEY=replace-with-a-long-random-token
# Require the token for every API request when exposing the gateway.
API_TOKEN_OPTIONAL=false

# Optional password for the browser login GUI.
RELAY_VNC_PASSWORD=

# Host IDs used by the container.
RELAY_USER_ID=1000
RELAY_GROUP_ID=1000

# ChatGPT is the default gateway. Gemini runs on the separate Compose service.
PROVIDER=chatgpt
